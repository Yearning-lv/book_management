<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentms.ui.controller.MainController"
            styleClass="main-root">
  <top>
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-top">
      <padding>
        <Insets top="14" right="20" bottom="14" left="20" />
      </padding>
      <children>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="main-brand-lockup">
          <children>
            <ImageView fitWidth="42" fitHeight="42" pickOnBounds="true" preserveRatio="true" styleClass="main-mark">
              <image>
                <Image url="@/images/app-mark.png" />
              </image>
            </ImageView>
            <VBox spacing="2" alignment="CENTER_LEFT">
              <children>
                <Label text="图书管理系统" styleClass="main-title" />
                <Label text="账户、馆藏、借阅与统计一体化管理平台" styleClass="main-tagline" />
              </children>
            </VBox>
          </children>
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="roleHintLabel" text="角色说明" styleClass="main-tagline" />
        <Label fx:id="userLabel" text="欢迎" styleClass="user-badge" />
        <Button fx:id="logoutButton" text="退出登录" onAction="#handleLogout" styleClass="header-action-button" />
      </children>
    </HBox>
  </top>
  <left>
    <VBox spacing="10" styleClass="main-menu">
      <padding>
        <Insets top="16" right="12" bottom="16" left="16" />
      </padding>
      <children>
        <Label text="功能导航" styleClass="menu-group-title" />
        <Button fx:id="userMenuButton" text="账户管理" onAction="#showUserPanel" styleClass="menu-button" />
        <Button fx:id="bookMenuButton" text="图书目录" onAction="#showBookPanel" styleClass="menu-button" />
        <Button fx:id="copyMenuButton" text="馆藏副本" onAction="#showCopyPanel" styleClass="menu-button" />
        <Button fx:id="circulationMenuButton" text="借阅中心" onAction="#showCirculationPanel" styleClass="menu-button" />
        <Button fx:id="statMenuButton" text="统计分析" onAction="#showStatPanel" styleClass="menu-button" />
      </children>
    </VBox>
  </left>
  <center>
    <StackPane fx:id="contentPane" styleClass="main-center">
      <children>
        <VBox spacing="10" alignment="CENTER" styleClass="main-welcome-card">
          <children>
            <Label text="欢迎进入图书管理系统" styleClass="main-title" />
            <Label text="请从左侧选择功能模块开始工作" styleClass="main-subtitle" />
          </children>
        </VBox>
      </children>
    </StackPane>
  </center>
</BorderPane>
